# Go Starter 环境变量配置示例
# 复制此文件为 .env 并根据环境修改相应值

# 应用配置
GO_STARTER_APP_ENVIRONMENT=development
GO_STARTER_APP_DEBUG=true

# 日志配置
GO_STARTER_LOG_LEVEL=debug
GO_STARTER_LOG_FORMAT=json
GO_STARTER_LOG_OUTPUT=stdout

# API 配置
GO_STARTER_API_ADDRESS=:8080

# 数据库配置（URL形式）
GO_STARTER_MYSQL_DSN=user:password@tcp(localhost:3306)/your_database_name?charset=utf8mb4&parseTime=True&loc=Local
GO_STARTER_POSTGRES_DSN=host=localhost user=postgres password=postgres dbname=your_database_name port=5432 sslmode=disable TimeZone=Local

# Redis 配置（URL形式）
GO_STARTER_REDIS_URL=redis://localhost:6379/0

# Kafka 配置
GO_STARTER_KAFKA_BROKER_1=localhost:9092
GO_STARTER_KAFKA_TOPIC=test

# 生产环境示例
# GO_STARTER_APP_ENVIRONMENT=production
# GO_STARTER_APP_DEBUG=false
# GO_STARTER_LOG_LEVEL=info
# GO_STARTER_MYSQL_DSN=user:password@tcp(mysql.production.com:3306)/prod_db?charset=utf8mb4&parseTime=True&loc=Local
# GO_STARTER_REDIS_URL=redis://redis.production.com:6379/0
