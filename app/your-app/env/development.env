# Go Starter 开发环境变量配置
# 复制此文件为 .env 并根据实际情况修改相应值

# 应用配置
GO_STARTER_APP_ENVIRONMENT=development
GO_STARTER_APP_DEBUG=true

# 日志配置
GO_STARTER_LOG_LEVEL=debug
GO_STARTER_LOG_FORMAT=json
GO_STARTER_LOG_OUTPUT=stdout

# API 配置
GO_STARTER_API_ADDRESS=:8080

# 数据库配置（URL形式）
GO_STARTER_MYSQL_DSN=user:password@tcp(dev-mysql:3306)/dev_db?charset=utf8mb4&parseTime=True&loc=Local
GO_STARTER_POSTGRES_DSN=host=dev-postgres user=postgres password=postgres dbname=dev_db port=5432 sslmode=disable TimeZone=Local

# Redis 配置（URL形式）
GO_STARTER_REDIS_URL=redis://dev-redis:6379/0

# Kafka 配置
GO_STARTER_KAFKA_BROKER_1=dev-kafka:9092
GO_STARTER_KAFKA_TOPIC=dev_topic
