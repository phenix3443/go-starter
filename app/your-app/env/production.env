# Go Starter 生产环境变量配置
# 复制此文件为 .env 并根据实际情况修改相应值

# 应用配置
GO_STARTER_APP_ENVIRONMENT=production
GO_STARTER_APP_DEBUG=false

# 日志配置
GO_STARTER_LOG_LEVEL=info
GO_STARTER_LOG_FORMAT=json
GO_STARTER_LOG_OUTPUT=stdout

# API 配置
GO_STARTER_API_ADDRESS=:8080

# 数据库配置（URL形式，使用环境变量）
GO_STARTER_MYSQL_DSN=${MYSQL_DSN}
GO_STARTER_POSTGRES_DSN=${POSTGRES_DSN}

# Redis 配置（URL形式，使用环境变量）
GO_STARTER_REDIS_URL=${REDIS_URL}

# Kafka 配置
GO_STARTER_KAFKA_BROKER_1=${KAFKA_BROKER_1}
GO_STARTER_KAFKA_TOPIC=${KAFKA_TOPIC}

# 生产环境示例（取消注释并修改为实际值）
# GO_STARTER_MYSQL_DSN=user:password@tcp(mysql.production.com:3306)/prod_db?charset=utf8mb4&parseTime=True&loc=Local
# GO_STARTER_POSTGRES_DSN=host=postgres.production.com user=postgres password=postgres dbname=prod_db port=5432 sslmode=require TimeZone=Local
# GO_STARTER_REDIS_URL=redis://redis.production.com:6379/0
